# Orbit Runner PvP - Environment Variables
# Copy to .env and configure for your deployment

# ============================================
# REQUIRED: Demos Blockchain Wallets
# ============================================
# Server wallet - receives entry fees (2 DEM) and store purchases (20%)
DEMOS_SERVER_MNEMONIC=your twelve word seed phrase for server wallet here

# Treasury wallet - for contest funds (can be same as server wallet)
DEMOS_TREASURY_MNEMONIC=your twelve word seed phrase for treasury wallet here

# ============================================
# Server Configuration
# ============================================
NODE_ENV=production
PORT=8787

# Legacy settings (may be deprecated)
TREASURY_MIN_RESERVE=3
PAYOUT_MIN_PRIZE=1

# ============================================
# Optional: Telegram Notifications
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================
# PvP Economy (configured in server/index.js)
# ============================================
# Entry Fee: 3 DEM (2 server, 1 pot)
# Store Split: 20% server, 80% pot
# Payout: 66% survivor, 22% killer, 12% remains